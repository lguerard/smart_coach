# =============================================================================
#  Configuration Docker — copier en .env puis completer
#    cp .env.example .env
# =============================================================================

# Sujet ntfy.sh secret pour la notification quotidienne (notify.py)
NTFY_TOPIC=change-me-to-a-secret-topic

# Fuseau horaire : pilote l'heure murale de tout le cron ci-dessous
TZ=Europe/Paris

# Heures (HH:MM, dans TZ) des quatre taches quotidiennes.
# IMPORTANT : INGEST_TIME doit tomber APRES votre reveil. Garmin ne
# publie le score de sommeil, la VFC et la recuperation qu'une fois la
# nuit terminee et la montre synchronisee -- un ingest lance pendant
# que vous dormez encore produit un message du matin sans aucun de ces
# signaux (le coach n'a alors que la batterie corps et le stress).
# Comptez ~15-30 min apres le reveil pour que la montre ait synchronise.
# INGEST_TIME=07:15
# COACH_TIME=07:45
# CHECKIN_AFTERNOON_TIME=16:00
# CHECKIN_EVENING_TIME=21:00

# Remote rclone (configure via `docker compose run --rm -it
# smart_coach-worker rclone config`) pointant vers l'export Health
# Connect. Deux formes acceptees :
#   - le fichier lui-meme : "gdrive:Sante Connect.zip" -- a preferer
#     quand l'export partage son dossier avec autre chose (Android ne
#     laisse pas toujours choisir la destination et ecrit alors a la
#     racine du Drive). Seul ce fichier est telecharge.
#   - un motif : "gdrive:*Connect.zip". Le plus simple quand le nom
#     porte un accent : "Connect" ne change pas d'une langue a
#     l'autre, et l'accent n'est pas ecrit du tout.
#   - le dossier : "gdrive:HealthConnectExports" ou "gdrive:" pour la
#     racine. Seuls les zips directement dedans sont recuperes, et
#     l'export est reconnu a son contenu, pas a son nom.
# Le nom du fichier suit la langue du telephone, donc listez-le :
#   rclone lsf gdrive: --max-depth 1 --include "*.zip"
# ("rclone lsd" ne montre que les dossiers, jamais le fichier.)
# Le ':' est obligatoire : sans lui rclone y voit un dossier local.
RCLONE_REMOTE=gdrive:HealthConnectExports

# Fenetre de recuperation Garmin API (seances + sommeil), en jours.
# Login initial : docker compose run --rm -it smart_coach-worker \
#   python -c "from ingest import garmin_api; garmin_api.get_client('<user>')"
# Monter a 365 une fois pour un backfill initial, puis revenir a 30.
# GARMIN_LOOKBACK_DAYS=30

# Token OAuth valable 1 an, genere par :
#   docker compose run --rm -it smart_coach-worker claude setup-token
# Auth abonnement Claude (Pro/Max/Team/Enterprise), PAS facturation API.
CLAUDE_CODE_OAUTH_TOKEN=change-me

# Optionnel : bascule vers l'API Anthropic (facturee au token) au lieu
# du CLI Claude ci-dessus. Laisser a claude_cli par defaut.
LLM_PROVIDER=claude_cli
# ANTHROPIC_API_KEY=change-me

# Secret des cookies de session (obligatoire des que le dashboard est
# accessible au-dela de votre machine). Generer :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# --- Exposition publique (profil compose "public") -------------------
# Domaine pointant (DNS A/AAAA) vers cette machine ; Caddy obtient le
# certificat HTTPS tout seul. Demarrer avec :
#   docker compose --profile public up -d
# DOMAIN=sport.exemple.fr

# En public : cookie de session marque Secure (jamais envoye en HTTP)
# COOKIE_SECURE=1

# En public : ne plus exposer le port applicatif en clair, Caddy
# devient la seule porte d'entree.
# WEB_BIND=127.0.0.1:8080
